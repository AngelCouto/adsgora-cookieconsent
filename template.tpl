// Adsgora CookieConsent
// GTM Community Template
// Orestbida CookieConsent 3.1.0 + Google Consent Mode v2

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const createQueue = require('createQueue');
const makeNumber = require('makeNumber');


// ============================================================
// LIBRERÍAS
// ============================================================

const COOKIECONSENT_JS =
  'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.umd.js';

const HELPER_JS =
     'https://cdn.jsdelivr.net/gh/AngelCouto/adsgora-cookieconsent@1.0.0/dist/adsgora-cookieconsent-helper.js';

// ============================================================
// GOOGLE CONSENT MODE v2 - ESTADO INICIAL
// ============================================================

if (data.enableConsentMode) {

  setDefaultConsentState({

    ad_storage:
      'denied',

    analytics_storage:
      'denied',

    ad_user_data:
      'denied',

    ad_personalization:
      'denied',

    functionality_storage:
      data.defaultFunctionality,

    personalization_storage:
      data.defaultFunctionality,

    security_storage:
      'granted',

    wait_for_update:
      makeNumber(data.waitForUpdate)
  });
}


// ============================================================
// GOOGLE TAG SETTINGS
// ============================================================

if (data.enableConsentMode) {

  gtagSet({

    url_passthrough:
      data.urlPassthrough,

    ads_data_redaction:
      data.adsDataRedaction
  });
}


// ============================================================
// DATALAYER
// ============================================================

const pushDataLayer =
  createQueue('dataLayer');


// ============================================================
// ACTUALIZACIÓN DEL CONSENTIMIENTO
//
// Categorías recibidas desde el helper:
//
// functionality
// analytics
// advertising
//
// necessary se corresponde con security_storage y permanece
// siempre concedido.
// ============================================================

const updateConsent = function(categories) {

  categories = categories || [];

  const functionality =
    categories.indexOf('functionality') >= 0;

  const analytics =
    categories.indexOf('analytics') >= 0;

  const advertising =
    categories.indexOf('advertising') >= 0;


  const consentState = {

    functionality_storage:
      functionality ? 'granted' : 'denied',

    personalization_storage:
      functionality ? 'granted' : 'denied',

    analytics_storage:
      analytics ? 'granted' : 'denied',

    ad_storage:
      advertising ? 'granted' : 'denied',

    ad_user_data:
      advertising ? 'granted' : 'denied',

    ad_personalization:
      advertising ? 'granted' : 'denied',

    security_storage:
      'granted'
  };


  // ----------------------------------------------------------
  // GOOGLE CONSENT MODE UPDATE
  // ----------------------------------------------------------

  if (data.enableConsentMode) {

    updateConsentState(
      consentState
    );
  }


  // ----------------------------------------------------------
  // EVENTO OPCIONAL AL DATALAYER
  // ----------------------------------------------------------

  if (data.pushConsentEvent) {

    pushDataLayer({

      event:
        'cookie_consent_update',

      functionality_storage:
        consentState.functionality_storage,

      personalization_storage:
        consentState.personalization_storage,

      analytics_storage:
        consentState.analytics_storage,

      ad_storage:
        consentState.ad_storage,

      ad_user_data:
        consentState.ad_user_data,

      ad_personalization:
        consentState.ad_personalization,

      security_storage:
        consentState.security_storage
    });
  }
};


// ============================================================
// CONFIGURACIÓN DEL HELPER
//
// Todos los valores configurables proceden directamente
// de los campos de la plantilla GTM.
// ============================================================

const config = {

  // ----------------------------------------------------------
  // COOKIE
  // ----------------------------------------------------------

  cookie: {

    name:
      data.cookieName,

    acceptExpiration:
      makeNumber(data.acceptExpiration),

    rejectExpiration:
      makeNumber(data.rejectExpiration),

    revision:
      makeNumber(data.revision)
  },


  // ----------------------------------------------------------
  // IDIOMA
  // ----------------------------------------------------------

  language: {

    mode:
      data.languageMode,

    fallback:
      data.defaultLanguage
  },


  // ----------------------------------------------------------
  // TEXTOS
  //
  // standard:
  //   traducciones estándar del helper.
  //
  // custom:
  //   textos personalizados configurados en GTM.
  // ----------------------------------------------------------

  texts: {

    mode:
      data.textMode,

    bannerTitle:
      data.bannerTitle,

    bannerDescription:
      data.bannerDescription,

    accept:
      data.acceptText,

    reject:
      data.rejectText,

    preferences:
      data.preferencesText,

    preferencesTitle:
      data.preferencesTitle,

    preferencesDescription:
      data.preferencesDescription,

    save:
      data.savePreferencesText
  },


  // ----------------------------------------------------------
  // POLÍTICA DE COOKIES
  // ----------------------------------------------------------

  policy: {

    url:
      data.policyUrl,

    text:
      data.policyLinkText
  },


  // ----------------------------------------------------------
  // ACCESO PERMANENTE A PREFERENCIAS
  // ----------------------------------------------------------

  preferencesTab: {

    enabled:
      data.enablePreferencesTab,

    text:
      data.preferencesTabText,

    position:
      data.preferencesTabPosition
  },


  // ----------------------------------------------------------
  // DISEÑO
  //
  // bannerWidth se introduce como porcentaje:
  // 60 = 60% del viewport en escritorio.
  //
  // El comportamiento tablet/móvil lo gestionará
  // automáticamente el helper.
  // ----------------------------------------------------------

  design: {

    bannerWidth:
      makeNumber(data.bannerWidth),

    acceptButtonColor:
      data.acceptButtonColor,

    rejectButtonColor:
      data.rejectButtonColor,

    settingsButtonColor:
      data.settingsButtonColor
  }
};


// ============================================================
// EXPONER CONFIGURACIÓN AL HELPER
// ============================================================

setInWindow(
  'AdsgoraCookieConsentConfig',
  config,
  true
);


// ============================================================
// EXPONER CALLBACK DE CONSENTIMIENTO
// ============================================================

setInWindow(
  'AdsgoraCookieConsentUpdate',
  updateConsent,
  true
);


// ============================================================
// CARGAR HELPER
// ============================================================

const loadHelper = function() {

  injectScript(

    HELPER_JS,

    function() {
      data.gtmOnSuccess();
    },

    function() {
      data.gtmOnFailure();
    },

    'adsgora-cookieconsent-helper'
  );
};


// ============================================================
// CARGAR ORESTBIDA COOKIECONSENT
// ============================================================

injectScript(

  COOKIECONSENT_JS,

  loadHelper,

  function() {
    data.gtmOnFailure();
  },

  'orestbida-cookieconsent-3.1.0'
);


