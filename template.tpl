- name: Dependencies - Pinned versions
  code: |-
    const mockData = {
      enableConsentMode: true,
      defaultFunctionality: 'denied',
      waitForUpdate: 500,

      urlPassthrough: true,
      adsDataRedaction: true,
      pushConsentEvent: true,

      cookieName: 'cc_cookie',
      acceptExpiration: 730,
      rejectExpiration: 7,
      revision: 1,

      languageMode: 'auto',
      defaultLanguage: 'es',
      textMode: 'standard',

      policyUrl: '/politica-de-cookies/',
      policyLinkText: 'Política de cookies',

      enablePreferencesTab: true,
      preferencesTabText: '🍪',
      preferencesTabPosition: 'bottom-right',

      bannerWidth: 60,
      acceptButtonColor: '#2563EB',
      rejectButtonColor: '#30363D',
      settingsButtonColor: '#E9EEF2'
    };


    // Guardamos las URLs solicitadas por la plantilla.
    let firstScriptUrl;
    let secondScriptUrl;
    let scriptCount = 0;


    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {

      scriptCount++;

      if (scriptCount === 1) {
        firstScriptUrl = url;
      }

      if (scriptCount === 2) {
        secondScriptUrl = url;
      }

      // Simulamos una carga correcta.
      onSuccess();
    });


    runCode(mockData);


    // Debe cargar primero Orestbida 3.1.0.
    assertThat(firstScriptUrl).isEqualTo(
      'https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.umd.js'
    );


    // Después debe cargar Adsgora 1.0.0.
    assertThat(secondScriptUrl).isEqualTo(
      'https://cdn.jsdelivr.net/gh/AngelCouto/adsgora-cookieconsent@1.0.0/dist/adsgora-cookieconsent-helper.js'
    );


    // Deben haberse solicitado exactamente dos scripts.
    assertThat(scriptCount).isEqualTo(2);


    // Y la etiqueta debe finalizar correctamente.
    assertApi('gtmOnSuccess').wasCalled();
